# Gemini
GEMINI_API_KEY=your_gemini_api_key_here
LLM_PROVIDER=gemini
LLM_SUMMARY_MODEL=gemini-3-flash-preview
LLM_CHAT_MODEL=gemini-3-flash-preview
LLM_TEMPERATURE_SUMMARY=0.1
LLM_TEMPERATURE_CHAT=0.3
LLM_TIMEOUT_SECONDS=0
LLM_MAX_RETRIES=3
LLM_RETRY_BASE_SECONDS=5
LLM_SUMMARY_MAX_OUTPUT_TOKENS=0
LLM_CHAT_MAX_OUTPUT_TOKENS=2048
LLM_THINKING_LEVEL=default

# Summary input strategy (the wording/language stays entirely in summary_prompt.txt)
SUMMARY_DIRECT_MAX_INPUT_TOKENS=100000
SUMMARY_MAP_BATCH_TOKENS=50000

# Faster-Whisper
STT_MODEL=large-v3-turbo
STT_DEVICE=auto
STT_COMPUTE_TYPE=auto
STT_LANGUAGE=auto
STT_VAD_FILTER=true
STT_MIN_SILENCE_MS=500
STT_BEAM_SIZE=2
STT_DOWNLOAD_ROOT=models

# Embedding and in-memory RAG
EMBEDDING_MODEL=intfloat/multilingual-e5-base
EMBEDDING_DEVICE=auto
EMBEDDING_BATCH_SIZE=32
RAG_CHUNK_TARGET_CHARS=600
RAG_MIN_CHUNK_DURATION_SECONDS=0
RAG_MAX_CHUNK_DURATION_SECONDS=86400
RAG_SILENCE_GAP_SECONDS=2
RAG_TOP_K_CANDIDATES=12
RAG_TOP_K_FINAL=6
RAG_NEIGHBOR_WINDOW=1
RAG_RRF_K=60

# Local artifact policy
OUTPUT_DIR=summary_results
SAVE_DEBUG_ARTIFACTS=false

# Meeting Platform integration
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=meeting
RABBITMQ_PASSWORD=meeting123
RABBITMQ_REQUEST_QUEUE=recording.ai.transcript.request.v1
RABBITMQ_EVENT_EXCHANGE=recording.ai.event
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=meeting-recordings
MINIO_SECURE=false
TASKFLOW_INTERNAL_TOKEN=change-me
RAG_CACHE_SIZE=4
